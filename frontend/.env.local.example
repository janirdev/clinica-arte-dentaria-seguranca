# Exemplo de variaveis de ambiente DO SERVIDOR (modo seguro).
# Copia este ficheiro para ".env.local" (que NAO vai para o git) e preenche.
#
# Estas variaveis sao lidas SO no servidor Next (route handlers do BFF),
# nunca no codigo do browser. E aqui que um segredo deve viver -- ao contrario
# da API_KEY_DEMO que esta em lib/api.js (exemplo da falha, modo vulneravel).

# URL do backend seguro (usada pelo BFF, lado servidor)
SECURE_API_URL=http://localhost:8082/api

# Exemplo de um segredo que NUNCA pode ir para o browser:
# API_KEY=coloca-aqui-a-chave-real
